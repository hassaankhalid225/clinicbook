# ─────────────────────────────────────────────────────────────
# ClinicBook environment variables
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

# --- Database (Supabase Postgres) ---
# Project Settings → Database → Connection string (use the "Connection pooling" URI for DATABASE_URL
# and the direct connection for DIRECT_URL).
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- Supabase Auth ---
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Marketplace data source: "prisma" = real database, "mock" = in-memory demo.
NEXT_PUBLIC_DATA_SOURCE="prisma"

# --- Integrations (optional for MVP; features degrade gracefully without them) ---
# Twilio (SMS)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Resend (email)
RESEND_API_KEY=""
EMAIL_FROM="ClinicBook <noreply@clinicbook.io>"

# Stripe (billing) — leave blank to run payments in mock mode
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Telehealth video — base URL for room links (default: public Jitsi Meet).
# Point to a self-hosted Jitsi or Daily.co room base for HIPAA-grade video.
NEXT_PUBLIC_VIDEO_BASE="https://meet.jit.si"

# Reminders cron — protects /api/cron/reminders. Leave blank to allow locally.
CRON_SECRET=""
