// ClinicBook — Prisma schema
// Backed by Supabase Postgres. Mirrors the schema in the project document (section 12),
// realized in Prisma. The `doctors.id` equals the Supabase Auth user id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Plan {
  free
  starter
  practice
  pro
}

enum AppointmentStatus {
  scheduled
  completed
  cancelled
  no_show
}

enum WaitlistStatus {
  waiting
  invited
  booked
  expired
}

enum NotificationChannel {
  sms
  email
}

enum NotificationType {
  confirmation
  reminder
  cancellation
  waitlist_invite
}

enum NotificationStatus {
  sent
  failed
  delivered
}

enum UserRole {
  admin
  doctor
  client
}

enum MarketplaceStatus {
  pending
  active
  suspended
}

enum ModuleStatus {
  active
  beta
  coming_soon
}

enum SubscriptionStatus {
  incomplete
  active
  past_due
  cancelled
}

enum PaymentKind {
  module_subscription
  booking
}

enum PaymentState {
  pending
  succeeded
  failed
  refunded
}

enum PaymentProvider {
  stripe
  mock
}

enum ApptPaymentStatus {
  unpaid
  paid
  refunded
  waived
}

enum QueueStatus {
  waiting
  in_progress
  completed
  skipped
  cancelled
}

model Doctor {
  id                   String   @id @db.Uuid // == Supabase auth user id
  email                String   @unique @db.VarChar(255)
  fullName             String   @map("full_name") @db.VarChar(100)
  slug                 String   @unique @db.VarChar(60)
  specialty            String?  @db.VarChar(100)
  clinicName           String?  @map("clinic_name") @db.VarChar(150)
  clinicAddress        String?  @map("clinic_address")
  phone                String?  @db.VarChar(20)
  timezone             String   @default("America/New_York") @db.VarChar(60)
  avatarUrl            String?  @map("avatar_url")
  bio                  String?
  plan                 Plan     @default(free)
  stripeCustomerId     String?  @map("stripe_customer_id") @db.VarChar(60)
  stripeSubscriptionId String?  @map("stripe_subscription_id") @db.VarChar(60)
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // --- Booking page customization ---
  welcomeMessage     String? @map("welcome_message")
  brandColor         String  @default("#0ea5e9") @map("brand_color") @db.VarChar(9)
  cancellationPolicy String? @map("cancellation_policy")
  currency           String  @default("USD") @db.VarChar(3)
  language           String  @default("en") @db.VarChar(5)

  // --- Notifications & reminders ---
  smsEnabled          Boolean @default(true) @map("sms_enabled")
  emailEnabled        Boolean @default(true) @map("email_enabled")
  reminderHoursBefore Int     @default(24) @map("reminder_hours_before") @db.SmallInt

  // --- No-show controls ---
  requireDeposit Boolean @default(false) @map("require_deposit")
  depositAmount  Decimal @default(0) @map("deposit_amount") @db.Decimal(10, 2)

  // --- Onboarding ---
  onboardedAt DateTime? @map("onboarded_at") @db.Timestamptz(6)

  // --- Multi-tenant + marketplace profile (v2) ---
  tenantId          String?           @map("tenant_id") @db.Uuid
  title             String?           @db.VarChar(60)
  experienceYears   Int               @default(0) @map("experience_years") @db.SmallInt
  languages         String[]          @default([])
  certifications    String[]          @default([])
  subSpecialties    String[]          @default([]) @map("sub_specialties")
  skills            String[]          @default([])
  procedures        String[]          @default([])
  education         Json?
  awards            Json?
  social            Json?
  city              String?           @db.VarChar(80)
  country           String?           @db.VarChar(80)
  geoLat            Float?            @map("geo_lat")
  geoLng            Float?            @map("geo_lng")
  coverUrl          String?           @map("cover_url")
  rating            Float             @default(0)
  reviewCount       Int               @default(0) @map("review_count")
  profileViews      Int               @default(0) @map("profile_views")
  featured          Boolean           @default(false)
  verified          Boolean           @default(false)
  marketplaceStatus MarketplaceStatus @default(active) @map("marketplace_status")

  tenant            Tenant?             @relation(fields: [tenantId], references: [id])
  availabilityRules AvailabilityRule[]
  blockedSlots      BlockedSlot[]
  appointments      Appointment[]
  waitlist          Waitlist[]
  services          Service[]
  doctorModules     DoctorModule[]
  marketReviews     DoctorReview[]
  queueEntries      QueueEntry[]
  receipts          Receipt[]
  payments          Payment[]
  subscription      TenantSubscription?

  @@map("doctors")
}

model Service {
  id           String   @id @default(uuid()) @db.Uuid
  doctorId     String   @map("doctor_id") @db.Uuid
  name         String   @db.VarChar(100)
  description  String?
  durationMin  Int      @default(30) @map("duration_min") @db.SmallInt
  priceCents   Int      @default(0) @map("price_cents")
  color        String   @default("#0ea5e9") @db.VarChar(9)
  isTelehealth Boolean  @default(false) @map("is_telehealth")
  intakeNote   String?  @map("intake_note")
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order") @db.SmallInt
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  doctor       Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([doctorId])
  @@map("services")
}

model AvailabilityRule {
  id              String   @id @default(uuid()) @db.Uuid
  doctorId        String   @map("doctor_id") @db.Uuid
  dayOfWeek       Int      @map("day_of_week") @db.SmallInt // 0=Sunday … 6=Saturday
  startTime       String   @map("start_time") @db.VarChar(5) // "09:00"
  endTime         String   @map("end_time") @db.VarChar(5) // "17:00"
  slotDurationMin Int      @default(30) @map("slot_duration_min") @db.SmallInt
  breakStart      String?  @map("break_start") @db.VarChar(5)
  breakEnd        String?  @map("break_end") @db.VarChar(5)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek])
  @@index([doctorId])
  @@map("availability_rules")
}

model BlockedSlot {
  id          String   @id @default(uuid()) @db.Uuid
  doctorId    String   @map("doctor_id") @db.Uuid
  blockedDate DateTime @map("blocked_date") @db.Date
  startTime   String?  @map("start_time") @db.VarChar(5) // null = full-day block
  endTime     String?  @map("end_time") @db.VarChar(5)
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, blockedDate])
  @@map("blocked_slots")
}

model Patient {
  id          String    @id @default(uuid()) @db.Uuid
  fullName    String    @map("full_name") @db.VarChar(100)
  email       String?   @db.VarChar(255)
  phone       String    @db.VarChar(20)
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  appointments Appointment[]
  waitlist     Waitlist[]

  @@index([phone])
  @@map("patients")
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  doctorId        String            @map("doctor_id") @db.Uuid
  patientId       String            @map("patient_id") @db.Uuid
  serviceId       String?           @map("service_id") @db.Uuid
  appointmentDate DateTime          @map("appointment_date") @db.Date
  startTime       String            @map("start_time") @db.VarChar(5) // "09:30"
  endTime         String            @map("end_time") @db.VarChar(5)
  status          AppointmentStatus @default(scheduled)
  reason          String?
  isTelehealth    Boolean           @default(false) @map("is_telehealth")
  videoRoomUrl    String?           @map("video_room_url")
  cancelToken     String            @unique @default(uuid()) @map("cancel_token") @db.Uuid
  depositPaid     Decimal?          @map("deposit_paid") @db.Decimal(10, 2)
  stripePaymentId String?           @map("stripe_payment_id") @db.VarChar(60)
  notes           String?
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  paymentStatus ApptPaymentStatus @default(unpaid) @map("payment_status")

  doctor       Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient      Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  service      Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  notifications NotificationLog[]
  payments     Payment[]
  receipt      Receipt?
  queueEntry   QueueEntry?

  // Prevents double-booking the same doctor/date/time at the database level.
  @@unique([doctorId, appointmentDate, startTime])
  @@index([doctorId, appointmentDate])
  @@index([cancelToken])
  @@map("appointments")
}

model Waitlist {
  id              String         @id @default(uuid()) @db.Uuid
  doctorId        String         @map("doctor_id") @db.Uuid
  patientId       String         @map("patient_id") @db.Uuid
  preferredDate   DateTime       @map("preferred_date") @db.Date
  notifiedAt      DateTime?      @map("notified_at") @db.Timestamptz(6)
  inviteExpiresAt DateTime?      @map("invite_expires_at") @db.Timestamptz(6)
  status          WaitlistStatus @default(waiting)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([doctorId, preferredDate, status])
  @@map("waitlist")
}

model NotificationLog {
  id            String             @id @default(uuid()) @db.Uuid
  appointmentId String             @map("appointment_id") @db.Uuid
  channel       NotificationChannel
  type          NotificationType
  sentAt        DateTime           @default(now()) @map("sent_at") @db.Timestamptz(6)
  status        NotificationStatus @default(sent)
  providerMsgId String?            @map("provider_msg_id") @db.VarChar(80)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("notifications_log")
}

// ════════════════════════════════════════════════════════════════════════════
// v2 — Multi-tenant platform: tenants, roles, modules + pricing, billing,
// receipts, queue, marketplace reviews.
// ════════════════════════════════════════════════════════════════════════════

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(150)
  slug      String   @unique @db.VarChar(80)
  status    String   @default("active") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  doctors       Doctor[]
  subscriptions TenantSubscription[]

  @@map("tenants")
}

/// Maps a Supabase auth user id to a platform role (RBAC anchor).
model UserProfile {
  id        String   @id @db.Uuid
  email     String   @unique @db.VarChar(255)
  fullName  String   @map("full_name") @db.VarChar(100)
  role      UserRole
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("user_profiles")
}

/// Sellable feature module. Admin edits price; history is audited.
model PlatformModule {
  id                String       @id @default(uuid()) @db.Uuid
  key               String       @unique @db.VarChar(40)
  name              String       @db.VarChar(80)
  description       String
  priceMonthlyCents Int          @default(0) @map("price_monthly_cents")
  isCore            Boolean      @default(false) @map("is_core")
  status            ModuleStatus @default(active)
  sortOrder         Int          @default(0) @map("sort_order") @db.SmallInt
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  selections   DoctorModule[]
  priceHistory ModulePriceHistory[]

  @@map("platform_modules")
}

model ModulePriceHistory {
  id            String   @id @default(uuid()) @db.Uuid
  moduleId      String   @map("module_id") @db.Uuid
  oldPriceCents Int      @map("old_price_cents")
  newPriceCents Int      @map("new_price_cents")
  changedBy     String?  @map("changed_by") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  module PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
  @@map("module_price_history")
}

/// A doctor's selected modules (their composed plan).
model DoctorModule {
  id          String   @id @default(uuid()) @db.Uuid
  doctorId    String   @map("doctor_id") @db.Uuid
  moduleId    String   @map("module_id") @db.Uuid
  active      Boolean  @default(true)
  activatedAt DateTime @default(now()) @map("activated_at") @db.Timestamptz(6)

  doctor Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  module PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([doctorId, moduleId])
  @@index([doctorId])
  @@map("doctor_modules")
}

model TenantSubscription {
  id                   String             @id @default(uuid()) @db.Uuid
  tenantId             String?            @map("tenant_id") @db.Uuid
  doctorId             String             @unique @map("doctor_id") @db.Uuid
  status               SubscriptionStatus @default(incomplete)
  provider             PaymentProvider    @default(mock)
  stripeCustomerId     String?            @map("stripe_customer_id") @db.VarChar(60)
  stripeSubscriptionId String?            @map("stripe_subscription_id") @db.VarChar(60)
  totalMonthlyCents    Int                @default(0) @map("total_monthly_cents")
  currentPeriodEnd     DateTime?          @map("current_period_end") @db.Timestamptz(6)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  doctor Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@map("tenant_subscriptions")
}

model Payment {
  id                    String          @id @default(uuid()) @db.Uuid
  doctorId              String?         @map("doctor_id") @db.Uuid
  appointmentId         String?         @map("appointment_id") @db.Uuid
  kind                  PaymentKind
  status                PaymentState    @default(pending)
  provider              PaymentProvider
  amountCents           Int             @map("amount_cents")
  currency              String          @default("USD") @db.VarChar(3)
  stripeSessionId       String?         @unique @map("stripe_session_id") @db.VarChar(120)
  stripePaymentIntentId String?         @map("stripe_payment_intent_id") @db.VarChar(120)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  doctor      Doctor?      @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  receipts    Receipt[]

  @@index([doctorId])
  @@index([appointmentId])
  @@map("payments")
}

model Receipt {
  id            String            @id @default(uuid()) @db.Uuid
  receiptNumber String            @unique @map("receipt_number") @db.VarChar(40)
  appointmentId String            @unique @map("appointment_id") @db.Uuid
  paymentId     String?           @map("payment_id") @db.Uuid
  doctorId      String            @map("doctor_id") @db.Uuid
  patientName   String            @map("patient_name") @db.VarChar(100)
  items         Json
  subtotalCents Int               @map("subtotal_cents")
  taxCents      Int               @default(0) @map("tax_cents")
  totalCents    Int               @map("total_cents")
  currency      String            @default("USD") @db.VarChar(3)
  paymentStatus ApptPaymentStatus @default(unpaid) @map("payment_status")
  notes         String?
  issuedAt      DateTime          @default(now()) @map("issued_at") @db.Timestamptz(6)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  payment     Payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  doctor      Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@map("receipts")
}

/// Daily walk-in/appointment queue with token numbers (rush management).
model QueueEntry {
  id            String      @id @default(uuid()) @db.Uuid
  doctorId      String      @map("doctor_id") @db.Uuid
  date          DateTime    @db.Date
  tokenNumber   Int         @map("token_number")
  appointmentId String?     @unique @map("appointment_id") @db.Uuid
  patientName   String      @map("patient_name") @db.VarChar(100)
  status        QueueStatus @default(waiting)
  checkedInAt   DateTime    @default(now()) @map("checked_in_at") @db.Timestamptz(6)
  startedAt     DateTime?   @map("started_at") @db.Timestamptz(6)
  completedAt   DateTime?   @map("completed_at") @db.Timestamptz(6)

  doctor      Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@unique([doctorId, date, tokenNumber])
  @@index([doctorId, date])
  @@map("queue_entries")
}

/// Marketplace reviews (patient-name based; verified when tied to a visit).
model DoctorReview {
  id            String    @id @default(uuid()) @db.Uuid
  doctorId      String    @map("doctor_id") @db.Uuid
  appointmentId String?   @map("appointment_id") @db.Uuid
  patientName   String    @map("patient_name") @db.VarChar(100)
  rating        Int       @db.SmallInt
  comment       String
  reply         String?
  repliedAt     DateTime? @map("replied_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@map("doctor_reviews")
}
